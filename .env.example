# --- Base de données (obligatoire en production) -------------------------------
# Neon Postgres (offre gratuite) : https://neon.tech ou via l'intégration Vercel.
# Sans valeur en développement, une base embarquée est créée dans .pglite/.
DATABASE_URL=

# Au déploiement, charge le catalogue de démonstration si la base est vide (true/false)
SEED_DEMO_CATALOG=false

# --- Sécurité -------------------------------------------------------------------
# 32 caractères minimum, aléatoire : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
# Adresse e-mail du premier administrateur : le compte créé avec cette adresse est admin.
ADMIN_EMAIL=

# --- Identité de la boutique ----------------------------------------------------
SHOP_NAME=Shopping & Accessories
SHOP_TAGLINE=
SHOP_DESCRIPTION=
# Hérité du gabarit : sans effet visible, la direction artistique est fixée dans src/app/theme.css
SHOP_THEME=papier
# XOF (franc CFA), EUR, USD…
SHOP_CURRENCY=XOF
# Pays livrés (codes ISO séparés par des virgules)
SHOP_COUNTRIES=BJ,TG,CI,SN,FR
# Minutes pendant lesquelles le stock est réservé à une commande impayée
ORDER_RESERVATION_MINUTES=30
# Bandeau « boutique de démonstration ». Mettre false = vente réelle (interdit le paiement de démonstration).
SHOP_DEMO_NOTICE=true

# --- Mentions légales (obligatoires en production) -------------------------------
SHOP_LEGAL_NAME=
SHOP_LEGAL_STATUS=Particulier, éditeur non professionnel
SHOP_LEGAL_ADDRESS=
SHOP_CONTACT_EMAIL=
SHOP_CONTACT_PHONE=
# Facultatifs (entreprise) : SIRET / RCCM / IFU, numéro de TVA
SHOP_COMPANY_ID=
SHOP_VAT_NUMBER=

# --- Paiement --------------------------------------------------------------------
# Fournisseurs proposés au client : demo, stripe (d'autres s'ajoutent en implémentant PaymentProvider)
PAYMENT_PROVIDERS=demo
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Une clé sk_live_ est refusée tant que ceci n'est pas true
ALLOW_LIVE_PAYMENTS=false

# --- E-mails (facultatif) ----------------------------------------------------------
RESEND_API_KEY=
MAIL_FROM=

# --- URL publique (sitemap, liens des e-mails). Sur Vercel : déduite automatiquement. --
SITE_URL=
